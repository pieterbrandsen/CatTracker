<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!--
      Needed only by `dotnet ef` at design time. Without ExcludeAssets=runtime its BuildHost
      folders (~4 MB of MSBuild machinery) get copied into the published app and shipped to the
      Mac, where nothing will ever run them.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!--
      EF's SQLite provider pulls SQLitePCLRaw.lib.e_sqlite3 2.1.11, which ships a SQLite build
      with a known high-severity advisory (GHSA-2m69-gcr7-jv3q). Pinned forward to the patched
      release in the same 2.1.x line, so the native binary is fixed without moving the managed
      provider across a major version. Remove once EF ships it itself.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />

    <!--
      EF's design-time package transitively pulls System.Security.Cryptography.Xml 9.0.0, which
      carries several high-severity advisories. Design-time only, but pinned forward regardless —
      a build that reports vulnerabilities you have decided to ignore soon reports nothing at all.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CatTracker.Core\CatTracker.Core.csproj" />
  </ItemGroup>

</Project>
