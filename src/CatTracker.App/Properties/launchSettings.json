        "CATTRACKER_CatTracker__FindMy__Source": "Replay",
        "CATTRACKER_CatTracker__Replay__SeedDays": "0",
        "CATTRACKER_CatTracker__DataDirectory": "%LOCALAPPDATA%\\CatTracker.Dev"
      }
    },
    "CatTracker (spool \u2014 needs a Mac)": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5185",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
