{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "CatTracker (replay)": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5185",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "CATTRACKER_CatTracker__FindMy__Source": "Replay",
        "CATTRACKER_CatTracker__Replay__SeedDays": "14",
        "CATTRACKER_CatTracker__DataDirectory": "%LOCALAPPDATA%\\CatTracker.Dev"
      }
    },
    "CatTracker (replay, no history)": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5185",
