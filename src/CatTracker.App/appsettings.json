{
  "urls": "http://0.0.0.0:5185",
  "_comment_Serilog": [
    "Every key under Override is a logger name, so no comment keys in there.",
    "Microsoft.EntityFrameworkCore is pinned to Warning because EF logs every statement at",
    "Information — seeding alone would write ~50k lines. Set CatTracker to Debug to see every",
    "geofence decision, every rejected fix and every poll."
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "CatTracker": "Information"
      }
    }
  },
  "CatTracker": {
    "DataDirectory": "",
    "TimeZone": "",
    "Diagnostics": {
      "RetainedDays": 30,
      "FileSizeLimitMb": 32,
      "Console": true
    },
    "FindMy": {
      "Enabled": true,
      "Source": "Spool",
      "SpoolDirectory": "",
      "DirectPath": "~/Library/Caches/com.apple.findmy.fmipcore/Items.data",
      "PollSeconds": 10,
      "StaleAfterMinutes": 45,
      "KeepRawSnapshots": 200
    },
    "Geofence": {
      "MaxAccuracyMeters": 100,
      "ConfirmationFixes": 2,
      "RejectOldFixes": true
    },
    "Alerts": {
      "MacNotifications": true,
      "Sound": true,
      "SoundName": "Submarine",
      "IMessageTo": "",
      "CooldownMinutes": 60,
      "LowBatteryAtOrAbove": 3
    },
    "Tiles": {
      "AllowNetwork": true,
      "UpstreamUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "UserAgent": "CatTracker/1.0 (self-hosted personal pet tracker)",
      "MaxSeedTiles": 20000,
      "SeedRatePerSecond": 4
    },
    "Replay": {
      "SeedDays": 14,
      "HomeLat": 52.0907,
      "HomeLon": 5.1214,
      "Seed": 1712,
      "PetName": "Demo Cat"
    }
  }
}
