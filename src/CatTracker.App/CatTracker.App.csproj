<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>cattracker</AssemblyName>
    <RootNamespace>CatTracker.App</RootNamespace>
    <Version>1.0.0</Version>
    <UserSecretsId>cattracker-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundles the console and rolling-file sinks plus appsettings binding, so log verbosity is
         a config change on the host rather than a redeploy. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />

    <!-- Lets the same binary run as a Windows Service. Inert on macOS. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CatTracker.Core\CatTracker.Core.csproj" />
    <ProjectReference Include="..\CatTracker.Data\CatTracker.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CatTracker.Tests" />
  </ItemGroup>

  <!--
    Microsoft.EntityFrameworkCore.Design drops BuildHost-net472 and BuildHost-netcore into the
    output — about 4 MB of MSBuild machinery that only `dotnet ef` uses at design time. Neither
    PrivateAssets nor ExcludeAssets removes them, because they arrive as build-target content
    rather than runtime assets, so they are dropped from the publish list explicitly.
  -->
  <Target Name="RemoveDesignTimeBuildHost" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('BuildHost-'))" />
    </ItemGroup>
  </Target>

</Project>
